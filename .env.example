# Public DNS name pointed at this server (for example prep.example.org)
LIBPREP_DOMAIN=prep.example.org

# Leave empty for a dedicated domain. For the HoustonLab deployment use /tools/libprep.
LIBPREP_ROOT_PATH=

# Generate with: openssl rand -base64 48
LIBPREP_SECRET_KEY=replace-with-a-long-random-secret

# Persistent storage on a large local volume; make it writable by UID 10001.
LIBPREP_DATA_PATH=/srv/libprep-data
LIBPREP_MAX_UPLOAD_GB=10
LIBPREP_REGISTRATION_ENABLED=true

# Used only to create the first production administrator. Remove the password after first start.
# Local development defaults to username admin / password admin when these are unset.
LIBPREP_ADMIN_USERNAME=admin
LIBPREP_ADMIN_EMAIL=admin@example.org
LIBPREP_ADMIN_NAME=Platform Administrator
LIBPREP_ADMIN_PASSWORD=replace-with-a-strong-initial-password
